# ------------------------------------------------------------------
# Variáveis do SERVIDOR (função /api/ai). Mesmo esquema do invictus.med.
# NUNCA use o prefixo VITE_ aqui: tudo que começa com VITE_ vai para o
# navegador. A chave da IA tem que ficar só no servidor.
#
# Para rodar localmente: copie este arquivo para ".env.local" e preencha.
# ------------------------------------------------------------------

# Chave principal do provedor compatível com a API da OpenAI.
# Padrão: Groq (https://console.groq.com/keys) — pode ser a MESMA do invictus.med.
LLM_KEY=

# Chave reserva (opcional). Usada se a principal falhar (cota, fora do ar…).
LLM_KEY_2=

# Endpoint "chat/completions" (opcional). Padrão: Groq.
# Exemplos:
#   Groq ......... https://api.groq.com/openai/v1/chat/completions
#   OpenAI ....... https://api.openai.com/v1/chat/completions
#   Cerebras ..... https://api.cerebras.ai/v1/chat/completions
#   OpenRouter ... https://openrouter.ai/api/v1/chat/completions
GATEWAY_URL=
# Endpoint da reserva (opcional; padrão = o mesmo de cima)
GATEWAY_URL_2=

# Modelos (opcionais). Padrões: openai/gpt-oss-120b (principal) e qwen/qwen3-32b (reserva).
# Use modelos DIFERENTES entre principal e reserva.
# Na OpenAI, por exemplo: LLM_MODEL=gpt-4.1-mini
LLM_MODEL=
LLM_MODEL_2=

# Código de acesso (recomendado em produção). Se definido, o app só usa a IA
# depois que você digitar esse código em Ajustes > Inteligência artificial.
# Evita que estranhos gastem a sua cota.
ACCESS_CODE=

# Exigir login (conta do app) para usar a IA. Use o ID do projeto Firebase.
# Com ACCESS_CODE também definido, vale um OU outro (útil para quem usa sem conta).
# Deixe vazio no seu computador para testar a IA sem login.
FIREBASE_PROJECT_ID=

# Origens permitidas (recomendado), separadas por vírgula.
# Ex.: https://anamnese.seudominio.workers.dev,https://anamnese.vercel.app
ALLOWED_ORIGINS=

# ------------------------------------------------------------------
# CONTAS (Firebase) — variáveis do NAVEGADOR (prefixo VITE_). Não são
# segredo: no Firebase para web essas chaves são públicas por definição.
# Por padrão o app usa o projeto do DPOC Clínico (mesma conta nos dois).
# Preencha só se quiser OUTRO projeto (ver docs/CONTAS.md).
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 1 = desliga contas/nuvem (app só no modo local, sem tela de login)
VITE_FIREBASE_DISABLED=
