rules_version = '2';
// Mesmas regras do DPOC Clínico: cada conta lê e escreve SÓ a própria pasta.
// Cobre usuarios/{uid}/pacientes (DPOC) e usuarios/{uid}/anamnese_* (este app).
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
